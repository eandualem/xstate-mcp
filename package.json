{
  "name": "xstate-mcp",
  "version": "1.0.1",
  "description": "MCP server bridging XState v5 inspection API to AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xstate-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "xstate",
    "state-machine",
    "model-context-protocol",
    "claude",
    "ai",
    "debugging",
    "inspection",
    "devtools",
    "statechart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eandualem/xstate-mcp.git"
  },
  "homepage": "https://github.com/eandualem/xstate-mcp#readme",
  "bugs": {
    "url": "https://github.com/eandualem/xstate-mcp/issues"
  },
  "author": "Elias Andualem",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "audit:check": "bun audit --ignore GHSA-g7r4-m6w7-qqqr"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@statelyai/inspect": "0.7.2",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "xstate": "5.32.6",
    "xstate-compat": "npm:xstate@5.28.0"
  },
  "engines": {
    "node": "^22.23.2 || ^24.20.0"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./inspection-policy": {
      "types": "./dist/inspection-policy.d.ts",
      "import": "./dist/inspection-policy.js"
    }
  }
}
